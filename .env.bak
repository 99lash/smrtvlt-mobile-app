# React Native Environment Variables
# Adjust BASE_URL for your setup:
# - Android Emulator: http://10.0.2.2:8000 (maps to localhost on host machine)
# - Physical Device: http://YOUR_MACHINE_IP:8000 (e.g., http://192.168.1.x:8000)
# - iOS Simulator: http://localhost:8000
BASE_URL=http://192.168.1.8:8000

# WebSocket URL (ws:// for unsecure, wss:// for secure)
EVENT_WS_URL=ws://192.168.1.8:8000/logs/ws

# Default query params (can be overridden if needed)
DEFAULT_VAULT_ID=2
DEFAULT_PREFIXES=Locked,Tamper,DUAL,Bruteforce,Multifactor